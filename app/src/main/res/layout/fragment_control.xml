<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".ui.control.ControlFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/bannerNotConnected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/control_banner_not_connected"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/textLastCommand"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="@string/last_command_none"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.08"
            android:text="@string/control_section_movement"
            android:textColor="?attr/colorPrimary" />

        <!-- A single molded gamepad body (Xbox-style), not two separate pieces: one dark face
             with two round grips flaring out underneath. Left stick and D-pad top-left/bottom-left
             like the real thing; Y/X/B/A diamond and right stick top-right/bottom-right. Only X
             (strafe left) and B (strafe right) are wired to a command — both sticks, Y, A, and the
             view/home/menu dots are decorative, same as the real controller's buttons we don't use. -->
        <FrameLayout
            android:id="@+id/cardMovement"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="140dp"
                android:background="@drawable/bg_gamepad_grip" />

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="140dp"
                android:background="@drawable/bg_gamepad_grip" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="300dp"
                android:layout_height="210dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/controller_body"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- view / home / menu dots -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_joycon_rail_button" />

                        <Space
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_joystick_cap" />

                        <Space
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_joycon_rail_button" />
                    </LinearLayout>

                    <!-- Left stick (decorative, top-left). -->
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="34dp"
                        android:layout_marginTop="26dp"
                        android:importantForAccessibility="no">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_joystick_base" />

                        <View
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_joystick_cap" />
                    </FrameLayout>

                    <!-- D-pad (bottom-left): forward / reverse / rotate left / rotate right. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="26dp"
                        android:layout_marginBottom="18dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnForward"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="@string/cmd_forward"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/controller_dpad"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_arrow_up"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="14dp"
                            app:iconTint="@color/white" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRotateLeft"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/cmd_rotate_left"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:backgroundTint="@color/controller_dpad"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_rotate_left"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="14dp"
                                app:iconTint="@color/white" />

                            <Space
                                android:layout_width="2dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRotateRight"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/cmd_rotate_right"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:backgroundTint="@color/controller_dpad"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_rotate_right"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconSize="14dp"
                                app:iconTint="@color/white" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReverse"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="2dp"
                            android:contentDescription="@string/cmd_reverse"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/controller_dpad"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_arrow_down"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="14dp"
                            app:iconTint="@color/white" />
                    </LinearLayout>

                    <!-- Y/X/B/A diamond (top-right): only X (strafe left) and B (strafe right)
                         are wired; Y and A are decorative, like the real buttons we don't use. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="26dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_xbox_button_yellow"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="Y"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStrafeLeft"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/cmd_strafe_left"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="0dp"
                                android:paddingVertical="0dp"
                                android:text="X"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/xbox_button_blue"
                                app:cornerRadius="15dp" />

                            <Space
                                android:layout_width="20dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStrafeRight"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/cmd_strafe_right"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="0dp"
                                android:paddingVertical="0dp"
                                android:text="B"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/xbox_button_red"
                                app:cornerRadius="15dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_xbox_button_green"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:text="A"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Right stick (decorative, bottom-right). -->
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="34dp"
                        android:layout_marginBottom="20dp"
                        android:importantForAccessibility="no">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_joystick_base" />

                        <View
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_joystick_cap" />
                    </FrameLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMission"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="20dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/control_section_mission"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeginExplore"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/cmd_begin_explore"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeginFastest"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/cmd_begin_fastest"
                    app:backgroundTint="?attr/colorTertiary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorOnTertiary"
                    app:rippleColor="?attr/colorOnTertiary"
                    android:textColor="?attr/colorOnTertiary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendArena"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/cmd_send_arena"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
