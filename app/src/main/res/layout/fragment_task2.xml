<?xml version="1.0" encoding="utf-8"?>
<!-- Task 2 (Fastest Car) tab. Laid out for landscape on the Galaxy Tab A7 Lite: the toolbar and
     status strip are hidden on this tab (see MainActivity); the height left after the header,
     summary line and run buttons is split between the schematic and the message log. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="12dp"
    tools:context=".ui.task2.Task2Fragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/task2_title"
            android:textColor="?attr/colorOnSurface" />

        <!-- F1-style lap timer: counts up from the RPi's START echo, freezes (gold flash) on
             DONE,TASK2. Up here in the header so it never covers the track. The gold glow is the
             container's background (alpha 0 until the "lap complete" flash) rather than a
             match_parent child view, which would stretch this wrap_content frame across the
             whole header and push Reset and the connection pill off screen. -->
        <FrameLayout
            android:id="@+id/lapTimerContainer"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/glow_lap_gold"
            android:contentDescription="@string/cd_task2_lap_timer">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:background="@drawable/bg_lap_timer_frame"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:letterSpacing="0.15"
                    android:text="@string/task2_lap_label"
                    android:textColor="@color/lap_timer_finished"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Monospace so the width doesn't jitter as the digits tick. -->
                <TextView
                    android:id="@+id/textLapTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/task2_lap_idle"
                    android:textColor="@color/lap_timer_idle"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Clears both obstacles back to "?" and the lap timer locally; sends nothing. Kept small and up here,
             away from START, so it can't be hit by mistake mid-run. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/task2_reset"
            android:textColor="?attr/colorError"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="?attr/colorError"
            app:strokeColor="?attr/colorError" />

        <!-- Connection indicator. Tapping it while disconnected opens the device picker. -->
        <LinearLayout
            android:id="@+id/connectionPill"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/connectionDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_status_dot" />

            <TextView
                android:id="@+id/textConnection"
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Connected" />
        </LinearLayout>
    </LinearLayout>

    <com.example.mdpg26.ui.task2.Task2ArenaView
        android:id="@+id/task2ArenaView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="5" />

    <TextView
        android:id="@+id/textTargets"
        style="@style/TextAppearance.Material3.TitleLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        tools:text="Obstacle 1: LEFT  |  Obstacle 2: ?" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/glow_calib"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalibrateStraight"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/task2_calib_straight"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:backgroundTint="@color/xbox_button_green"
                app:cornerRadius="48dp"
                app:strokeColor="@color/glow_calib_green"
                app:strokeWidth="2dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/glow_gyro"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGyroInitCalib"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/task2_gyro_init_calib"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/xbox_button_blue"
                app:cornerRadius="48dp"
                app:strokeColor="@color/glow_gyro_blue"
                app:strokeWidth="2dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/glow_start"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/task2_start"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@color/xbox_button_red"
                app:cornerRadius="48dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconSize="28dp"
                app:strokeColor="@color/glow_start_red"
                app:strokeWidth="2dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Sent/received log: the same shared message list (and bubbles) as the Terminal tab, under
         a dashboard-style "ENGINE LOG" header. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="4"
        android:background="@drawable/bg_engine_log_frame"
        android:orientation="vertical"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_engine_log_header">

            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:paddingVertical="8dp"
                android:text="@string/task2_engine_log_title"
                android:textColor="@color/white" />

            <!-- Clears the shared message log, after a confirmation. -->
            <ImageButton
                android:id="@+id/btnClearLog"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_clear_log"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete"
                app:tint="@color/white" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="6dp"
                tools:listitem="@layout/item_message_received" />

            <TextView
                android:id="@+id/textMessagesEmpty"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/task2_log_empty"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="italic" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
