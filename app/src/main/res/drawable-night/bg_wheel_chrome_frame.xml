<!-- Dark theme: brushed-chrome rim around the Wheel tab's controller body — the same metal gradient as the
     Task 2 ENGINE LOG bezel (bg_engine_log_frame), so both tabs share one "instrument" look. The
     host pads itself by the rim width and the card inside supplies the dark body. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#8A9099"
        android:endColor="#B7BCC3"
        android:startColor="#DEE1E5" />
    <corners android:radius="33dp" />
</shape>
