<!-- F1-style lap timer plate on the Task 2 header: the same brushed-chrome bezel as
     bg_engine_log_frame, around a near-black "LCD" face so the digits read like a pit-wall
     timing screen in both light and dark themes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#8A9099"
                android:endColor="#B7BCC3"
                android:startColor="#DEE1E5" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/lap_timer_face_top"
                android:startColor="@color/lap_timer_face" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
