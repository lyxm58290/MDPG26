<!-- Dashboard-style "ENGINE LOG" label plate, floating in the middle of
     bg_engine_log_frame's top bezel (margins keep it clear of the frame's left/right/top edges,
     so the chrome shows around it rather than the plate spanning edge to edge). Subtle
     top-to-bottom gradient for a brushed-metal look instead of a flat fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="#1E1E22"
        android:startColor="#34343A" />
    <corners android:radius="10dp" />
    <!-- Chrome hairline so the plate still reads against the dark-theme log fill. -->
    <stroke
        android:width="1dp"
        android:color="@color/chrome_stroke" />
</shape>
