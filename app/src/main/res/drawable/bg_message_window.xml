<!-- Message log panel (Task 2 tab). Plain surface + outline rather than a surfaceVariant fill, so
     received bubbles (which are surfaceVariant) stand out against it, as they do on the Terminal tab. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="16dp" />
</shape>
